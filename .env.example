# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8804
MYSQL_PORT=3308

# MySQL 스키마명
MYSQL_DATABASE=plip_topic

# Kafka (토픽↔다이어리 영상 동기화). compose 안 앱은 kafka:9092, IDE bootRun은 localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
