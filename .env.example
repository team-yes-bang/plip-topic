# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8804
MYSQL_PORT=3308

# MySQL 스키마명
MYSQL_DATABASE=plip_topic

# Redis (조회 캐시: agitUuid + date/yearMonth)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (토픽↔다이어리 영상 동기화). compose 안 앱은 kafka:9092, IDE bootRun은 localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# MongoDB (단건 뷰어 스냅샷 topic_viewer). compose 안 앱은 mongo:27017, IDE bootRun은 localhost:27017
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/plip_topic
MONGO_PORT=27017
