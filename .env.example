# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8804
MYSQL_PORT=3308

# MySQL 스키마명
MYSQL_DATABASE=plip_topic

# Redis: 조회 캐시(topic:latest:…)와 agit 멤버십 Hash(agit:{uuid}:members)는 같은 인스턴스.
# agit와 REDIS_HOST/REDIS_PORT를 맞출 것. 로컬 compose의 plip-topic-redis와 plip-agit-redis는 기본 분리됨.
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (토픽↔다이어리 영상 동기화). compose 안 앱은 kafka:9092, IDE bootRun은 localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# MongoDB (단건 뷰어 스냅샷 topic_viewer). compose 안 앱은 mongo:27017, IDE bootRun은 localhost:27017
# Spring Boot 4는 spring.mongodb.uri ← SPRING_MONGODB_URI. 예전 SPRING_DATA_MONGODB_URI도 yaml에서 받는다.
SPRING_MONGODB_URI=mongodb://localhost:27017/plip_topic
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/plip_topic
MONGO_PORT=27017

# agit 멤버십 워밍 (게이트웨이 아님). Hash 키 미스 시 1회 GET /internal/v1/agits/{agitUuid}/members
# 워밍이 agit 프로세스에 닿아야 한다. 로컬 IDE는 agit local 포트(기본 8083).
AGIT_INTERNAL_BASE_URL=http://localhost:8083

# video가 topic 재생 access HEAD에 넣는 키와 동일해야 한다 (video TOPIC_INTERNAL_API_KEY).
INTERNAL_API_KEY=local-dev-internal-key
